<?xml version="1.0" encoding="utf-8"?>
<!-- Start button background: rounded rectangle with a turquoise gradient -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- angle 270 = gradient from top to bottom -->
    <gradient
        android:angle="270"
        android:startColor="@color/aqua_start"
        android:endColor="@color/aqua_end" />
    <corners android:radius="40dp" />
</shape>