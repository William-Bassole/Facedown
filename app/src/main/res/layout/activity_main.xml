<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen: title, timer bubble, status message and start button.
     The root id "main" is used by MainActivity for window insets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/night_blue">

    <!-- App title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:textSize="36sp"
        android:textStyle="bold" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <!-- Flexible space above the timer -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Session timer -->
    <TextView
        android:id="@+id/timerText"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:background="@drawable/bg_timer"
        android:gravity="center"
        android:text="@string/timer_default"
        android:textColor="@color/text_primary"
        android:textSize="56sp" />

    <!-- Session status message -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="32dp"
        android:gravity="center"
        android:text="@string/status_ready"
        android:textColor="@color/text_secondary"
        android:textSize="18sp" />

    <!-- Flexible space below the status message -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Start button (backgroundTint set to null so the custom gradient is kept) -->
    <Button
        android:id="@+id/startButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_button"
        app:backgroundTint="@null"
        android:text="@string/start_session"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

</LinearLayout>